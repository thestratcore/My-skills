# Static site served by unprivileged nginx on 8080. Pin base images by digest at onboarding:
#   docker buildx imagetools inspect node:24-alpine   (copy the index digest)
ARG NODE_IMAGE=node:24-alpine
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.29-alpine

FROM --platform=$BUILDPLATFORM ${NODE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# Optional build identity (release-config images.<key>.buildMetadata = true):
ARG APP_RELEASE_BUILD=0
ARG APP_COMMIT
ARG APP_BUILD_TIME
RUN APP_RELEASE_BUILD="$APP_RELEASE_BUILD" APP_COMMIT="$APP_COMMIT" APP_BUILD_TIME="$APP_BUILD_TIME" npm run build

FROM ${NGINX_IMAGE}
COPY ops/container/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/healthz || exit 1
