{
  "schema": 2,
  "project": "PROJECT",
  "source": "https://github.com/thestratcore/REPO",
  "mode": "production",
  "productionHostname": "n8n",
  "deployDir": null,
  "envFiles": [],
  "composeFile": "ops/compose.production.yml",
  "checks": [
    ["python3", "-m", "unittest", "discover", "-s", "ops", "-p", "test_release.py"],
    ["npm", "ci", "--no-audit", "--no-fund"],
    ["npm", "test"]
  ],
  "images": {
    "web": {"repository": "ghcr.io/thestratcore/PROJECT-web", "dockerfile": "Dockerfile", "target": null, "buildMetadata": false}
  },
  "services": {
    "PROJECT": {"role": "app", "image": "web", "container": "PROJECT", "port": {"host": 8080, "container": 8080}, "mounts": []}
  },
  "smoke": {
    "service": "PROJECT",
    "paths": ["/healthz", "/"],
    "execChecks": [{"service": "PROJECT", "command": ["nginx", "-t"]}]
  },
  "legacyEnvironment": {}
}
